{
  "name": "the-last-pact-guardian-discord-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bot Discord The Last Pact Guardian, senza dashboard web.",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "register-commands": "tsx scripts/register-commands.ts",
    "config:import": "tsx scripts/import-config.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2"
  }
}
